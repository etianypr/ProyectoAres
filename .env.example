# Copia este archivo como ".env.local" y completa con los datos de tu proyecto
# Supabase. En Supabase: Project Settings -> Data API / API Keys
#
# OJO: este es el proyecto Supabase DE ARES, no el del sistema del que se
# separó. Si acá aparece la URL de la base vieja, la app va a escribir sobre los
# datos de la otra empresa.

# URL del proyecto (ej. https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública "anon" (publishable). Es segura para el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave "service_role". NO es pública: salta RLS por completo. Solo se usa en el
# servidor, para crear las cuentas de acceso de los conductores (invitaciones).
SUPABASE_SERVICE_ROLE_KEY=


# --- Integración WhatsApp Business (Meta Cloud API) ---
# Para avisarle al destinatario que su encomienda va en reparto.
# String que tú inventas; debe coincidir con "Token de verificación" en
# Meta > WhatsApp > Configuración > Webhooks.
WHATSAPP_VERIFY_TOKEN=
# Datos de Meta > WhatsApp > Introducción rápida (token permanente más adelante).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Secreto de la app: Meta > Configuración de la app > Básica > "Clave secreta".
# NO es el mismo que WHATSAPP_VERIFY_TOKEN. Con este se comprueba la FIRMA
# (HMAC-SHA256) de cada evento que llega al webhook.
#
# Sin esto el webhook rechaza TODO, a propósito: un webhook sin verificar deja
# que cualquiera que conozca la URL invente respuestas de receptores y le meta
# confirmaciones falsas a la ruta del conductor. Preferimos no recibir respuestas
# antes que recibir respuestas inventadas.
WHATSAPP_APP_SECRET=

# La plantilla aprobada por Meta con la que sale el aviso, y su idioma. Tiene que
# tener DOS variables en el cuerpo (nombre del receptor y cuándo llega) y TRES
# botones de respuesta rápida, en este orden (texto completo en docs/WHATSAPP.md):
#   0 = "Sí, estaré"   1 = "Mañana"   2 = "Otro horario"
#
# ⚠️ El ORDEN de los botones importa y no se puede comprobar desde el código: el
# payload se manda por índice. Si alguien los reordena en el panel de Meta, el
# "sí" de un receptor llega como "Mañana" y ese pedido sale de la ruta.
WHATSAPP_PLANTILLA_AVISO=aviso_encomienda
WHATSAPP_PLANTILLA_IDIOMA=es
# Pausa de los avisos (2026-10-28, pruebas con etiquetas reales): sin esta variable,
# o con cualquier valor que no sea "no", no sale ningún WhatsApp aunque haya token.
# WHATSAPP_EN_PAUSA=no

# --- App Android (APK, spec 015) ---
# Versión mínima de la APK: si la instalada es menor, la app avisa que hay que
# instalar el archivo nuevo (solo hace falta cuando cambia la parte nativa). Vacía
# = sin aviso. APK_URL es de dónde se baja (el Release de GitHub).
APK_VERSION_MINIMA=
APK_URL=

# --- Lectura con IA de la guía y las etiquetas (spec 005) ---
# Clave de la API de Anthropic (console.anthropic.com). SOLO servidor: nunca con
# NEXT_PUBLIC_. Las fotos pasan por /api/lectura y no se guardan (docs/PRIVACIDAD.md).
# Vacía = la app funciona sin IA (texto pegado de Google Lens + código de barras).
ANTHROPIC_API_KEY=
# Solo si la clave es de usuario (sk-ant-usr…) y no de un workspace: el ID del
# workspace (wrkspc_…, no es secreto). La API lo pide en cada consulta.
ANTHROPIC_WORKSPACE_ID=
# Modelo para las etiquetas que el teléfono no pudo leer; vacío = claude-opus-5.
# Barato y suficiente: claude-haiku-4-5 (spec 005, T030 compara).
LECTURA_MODELO=
# Modelo para la guía; vacío = claude-opus-5 (~US$0,03 por foto, ~US$3 al mes).
# Más barato y también leyó 10/10 una foto difícil: claude-haiku-4-5. Si el
# teléfono ve una OF que la lectura no trajo, se relee con
# LECTURA_MODELO_GUIA_ALTA; vacío = claude-opus-5.
LECTURA_MODELO_GUIA=
LECTURA_MODELO_GUIA_ALTA=

# --- Google Geocoding (spec 016 y 019): el número de casa de cada dirección ---
# Clave de Google Cloud con la "Geocoding API" activada (requiere facturación;
# 10.000 gratis al mes, un día usa unas 100). Ponerle un TOPE DIARIO en la consola
# de Google (APIs y servicios → Geocoding API → Cuotas, unas 300 al día) para que
# nunca cobre. SOLO servidor: el teléfono pregunta por /api/geocodificar.
# Vacía = sin Google: solo OSM y Plus Codes, casi sin números de casa.
GOOGLE_MAPS_KEY=
# Google Cloud Vision (spec 005): el lector de texto de Google Lens dentro de la
# app, para las fotos de etiquetas y guía. Vacía = se usa GOOGLE_MAPS_KEY (la
# misma clave con la "Cloud Vision API" activada); sin ninguna, el lector del
# teléfono. ~US$1,50 cada 1.000 fotos, las primeras 1.000 del mes gratis.
GOOGLE_VISION_KEY=

# --- OpenRouteService (OPCIONAL, solo para el servidor MCP) ---
# Trazado por calles abierto, sobre el grafo de OpenStreetMap. Lo usa
# get_route_ch en mcp/. La app del conductor usa NEXT_PUBLIC_ORS_KEY (abajo), y
# quien guía es la app Google Maps (spec 020).
#
# Se saca gratis en openrouteservice.org (2.000 consultas/día). Sin esto el
# sistema funciona igual: solo se apaga esa herramienta, y lo dice.
#
# OJO: SIN el prefijo NEXT_PUBLIC_. Esta clave se usa desde el servidor y no
# tiene por qué viajar al teléfono.
ORS_API_KEY=

# La misma cuenta de OpenRouteService, para la matriz de distancias por calle
# con que el teléfono ordena la ruta (lib/geo/matriz.ts) y la línea del día con sus
# tramos por parada (lib/geo/ors/direcciones.ts). Esta SÍ viaja al
# teléfono: la consulta lleva puntos de destinatarios y
# no puede pasar por el servidor. Es gratis y sin tarjeta: pasado el límite del
# día ORS rechaza la consulta y la ruta se ordena en línea recta; nunca cobra.
NEXT_PUBLIC_ORS_KEY=

# Instancia propia de OpenRouteService, si algún día hay que cortar la
# dependencia del servicio alojado (ORS o Valhalla en un contenedor con el
# extracto OSM de Chile). Vacío = el servicio público.
ORS_BASE=
