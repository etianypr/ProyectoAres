{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/revisar-commit.mjs\"",
            "timeout": 30,
            "statusMessage": "Revisando datos de destinatarios en el commit"
          }
        ]
      }
    ]
  }
}
