# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# El .example de la migración también se versiona: es una plantilla sin secretos.
# Sin esta línea lo tapa el .env* de arriba (que sí tiene que tapar al
# .env.migracion de verdad, donde van las dos llaves service_role).
!.env.migracion.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
