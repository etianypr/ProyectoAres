# Credenciales para el traslado de datos, UNA SOLA VEZ (scripts/migrar-datos.mjs).
# Copiá este archivo como ".env.migracion" y completá los cuatro valores.
#
# Las dos llaves son service_role: el script tiene que LEER saltándose RLS y
# ESCRIBIR filas con ids ya decididos. No las pegues en ningún otro lado, y
# borrá .env.migracion cuando la migración esté verificada — .gitignore ya
# impide que se suban, pero seguirían en el disco.

# --- La base del sistema del que nos separamos (solo se LEE) ---
ORIGEN_SUPABASE_URL=
ORIGEN_SERVICE_ROLE_KEY=

# --- La base de ares (se ESCRIBE) ---
# Tiene que ser un proyecto distinto del de arriba: el script se niega a correr
# si las dos URLs coinciden.
DESTINO_SUPABASE_URL=
DESTINO_SERVICE_ROLE_KEY=
