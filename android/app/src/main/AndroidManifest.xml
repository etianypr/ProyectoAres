<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- La burbuja de ARES sobre Google Maps (spec 020): un servicio en primer
             plano sostiene la ventana mientras ARES está atrás. "location" solo para
             abrir la burbuja al llegar a la parada, con la ubicación pasiva que ya
             pide Google Maps y mientras la burbuja está en curso (FR-016; la
             constitución deja fuera el GPS permanente salvo spec explícita). Guía
             Google Maps. -->
        <service
            android:name=".BurbujaServicio"
            android:exported="false"
            android:foregroundServiceType="specialUse|location">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Muestra la parada de reparto activa sobre la app de navegacion, con sus botones." />
        </service>

        <!-- Escáner de Google (ML Kit) con su propia pantalla: sin permiso de cámara
             (spec 015, US3). -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Navegación con la app abierta (spec 015, FR-011). Sin permiso de segundo
         plano: la constitución deja fuera el GPS permanente. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Llamar con un toque (spec 015, FR-004). Ya no se lee el registro de llamadas:
         saber si contestó no ayuda a repartir (el dueño, 2026-11-06, spec 020). -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- La burbuja de ARES sobre Google Maps (spec 020): "Mostrar sobre otras
         apps" lo da el conductor una vez; el servicio en primer plano evita que
         Android cierre ARES mientras está atrás. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- El escáner de etiquetas en vivo (spec 028): la cámara de ARES al cargar el
         auto. Se pide la primera vez que se abre. El escáner de Google y la cámara
         del sistema no lo necesitaban. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Una vibración corta cuando la etiqueta queda leída (spec 028). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
